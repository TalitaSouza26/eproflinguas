# Supabase (projeto próprio do Línguas, independente do eprof.app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada só no servidor, para a geração de questões. Nunca exponha no client.
ANTHROPIC_API_KEY=

# Opcional: "1" pula a checagem de sessão e aceita a senha de teste.
# Vale também no protótipo publicado, que roda sem banco. Desliga sozinho
# quando as chaves do Supabase acima estiverem preenchidas.
LINGUAS_DEV_BYPASS_AUTH=

# Opcional, só em desenvolvimento: senha aceita pelo login de teste (padrão: 12345).
LINGUAS_DEV_PASSWORD=
