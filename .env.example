# Supabase (projeto próprio do Línguas, independente do eprof.app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada só no servidor, para a geração de questões. Nunca exponha no client.
ANTHROPIC_API_KEY=

# Opcional, só em desenvolvimento: "1" pula a checagem de sessão no proxy.
# Ignorado em produção.
LINGUAS_DEV_BYPASS_AUTH=

# Opcional, só em desenvolvimento: senha aceita pelo login de teste (padrão: 12345).
LINGUAS_DEV_PASSWORD=
